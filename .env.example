# Local gateway & health check key (never accepted on public /mcp when OAuth is enabled)
MCP_SECRET_KEY=

# Public HTTPS base URL & tunnel mode: ssh | cloudflared | ngrok
PUBLIC_URL=https://your-host.example.com
COOP_TUNNEL_MODE=cloudflared
COOP_SSH_HOST=your.vps.ip
COOP_SSH_USER=ubuntu
COOP_SSH_KEY=C:\path\to\your\ssh.key
COOP_SSH_REMOTE_PORT=18089

# Local HTTP bind port
PORT=8089
HOST=127.0.0.1

# Default sandbox roots (comma-separated read roots; outputs confined to write root)
# Leave blank to use ./workspace and ./workspace/output inside the repo folder
COOP_READ_ROOTS=
COOP_WRITE_ROOT=
COOP_CLOUD_SYNC_DIR=
COOP_GDRIVE_MIRROR_DIR=

# External stdio/http/sse MCP plugins manifest (defaults to ./apps.json if present)
COOP_APPS_CONFIG=apps.json
COOP_IDLE_TIMEOUT=900
COOP_SOFT_STEP_WARNING=25
COOP_MAX_BATCH_STEPS=100

# Optional hardened Blender bridge (127.0.0.1 loopback)
COOP_BLENDER_EXE=
COOP_BLENDER_HOST=127.0.0.1
COOP_BLENDER_PORT=9877
COOP_BLENDER_HEADLESS_PORT=9878
COOP_BLENDER_TOKEN=

# OAuth 2.1 + PKCE settings
COOP_REQUIRE_OAUTH=true
COOP_OAUTH_CLIENT_ID=coop-mcp-client
COOP_OAUTH_CLIENT_SECRET=
COOP_OAUTH_JWT_SECRET=
COOP_OAUTH_PASSWORD_HASH=
# Redirect policy: "strict" (Gemini + Claude + custom allowlist) or "permissive" (any HTTPS redirect, use at your own risk)
COOP_OAUTH_REDIRECT_MODE=strict
# Optional comma-separated extra allowed OAuth redirect hostnames (used in strict mode)
COOP_OAUTH_ALLOWED_REDIRECT_HOSTS=

# Second-layer Admin PIN hash (for temporary 1h sandbox elevation; set via: uv run python set_oauth_password.py --pin)
COOP_ADMIN_PIN_HASH=
COOP_ADMIN_TOKEN_TTL=3600
